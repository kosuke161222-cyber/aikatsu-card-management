const MASTER_VERSION='2026-10-07-full85-v1';
let cards=MASTER_CARDS.map(x=>({...x}));
let userDb=null;
let editingId=null;
let imageWasRemoved=false;
const USER_DB='aikatsuEncoreUser_v4';
const USER_DB_VERSION=1;
const USER_STORE='state';
const LEGACY_DB='aikatsuEncoreDB';
const PREVIOUS_USER_DB='aikatsuEncoreUser_v3';
const MASTER_VERSION_KEY='aikatsuEncoreMasterVersion';
const $=id=>document.getElementById(id);
function esc(s){return String(s).replace(/[&<>\"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[m]);}
function cloneMaster(){return MASTER_CARDS.map(x=>({...x}));}
function masterFor(id){return MASTER_CARDS.find(x=>x.id===id)||null;}
function openUserDB(){
  return new Promise((resolve,reject)=>{
    if(userDb)return resolve(userDb);
    if(!('indexedDB' in window))return reject(new Error('IndexedDB unavailable'));
    const req=indexedDB.open(USER_DB,USER_DB_VERSION);
    req.onupgradeneeded=()=>{
      const d=req.result;
      if(!d.objectStoreNames.contains(USER_STORE)) d.createObjectStore(USER_STORE,{keyPath:'id'});
    };
    req.onsuccess=()=>{userDb=req.result;resolve(userDb)};
    req.onerror=()=>reject(req.error||new Error('IndexedDB open failed'));
  });
}
async function getUserRows(){
  const d=await openUserDB();
  return await new Promise((resolve,reject)=>{
    const tx=d.transaction(USER_STORE,'readonly');
    const st=tx.objectStore(USER_STORE);
    const q=st.getAll();
    q.onsuccess=()=>resolve(q.result||[]);
    q.onerror=()=>reject(q.error||new Error('read failed'));
  });
}
async function putUserRow(row){
  const d=await openUserDB();
  await new Promise((resolve,reject)=>{
    const tx=d.transaction(USER_STORE,'readwrite');
    tx.objectStore(USER_STORE).put(row);
    tx.oncomplete=resolve;
    tx.onerror=()=>reject(tx.error||new Error('write failed'));
    tx.onabort=()=>reject(tx.error||new Error('write aborted'));
  });
}
async function deleteUserRow(id){
  try{
    const d=await openUserDB();
    await new Promise((resolve,reject)=>{
      const tx=d.transaction(USER_STORE,'readwrite');
      tx.objectStore(USER_STORE).delete(id);
      tx.oncomplete=resolve;
      tx.onerror=()=>reject(tx.error||new Error('delete failed'));
    });
  }catch(_){ }
}
function buildRowFromCard(card){
  const base=masterFor(card.id);
  if(!base)return {id:card.id,owned:Number(card.owned)||0,overrides:{}};
  const o={};
  for(const k of ['name','type','brand','category','rarity','promo']){
    if(card[k]!==base[k]) o[k]=card[k];
  }
  if(card.image!==base.image) o.image=card.image||null;
  return {id:card.id,owned:Math.max(0,Number.parseInt(card.owned,10)||0),overrides:o};
}
function applyRow(card,row){
  card.owned=Math.max(0,Number.parseInt(row?.owned,10)||0);
  const o=row?.overrides||{};
  for(const k of ['name','type','brand','category','rarity','promo']){
    if(Object.prototype.hasOwnProperty.call(o,k)) card[k]=o[k];
  }
  if(Object.prototype.hasOwnProperty.call(o,'image')) card.image=o.image||'';
}
async function migrateToStableStoreOnce(){
  if(localStorage.getItem(MASTER_VERSION_KEY)===MASTER_VERSION)return;
  // Old browser stores may contain stale card metadata. Keep only collection counts once.
  // The embedded 85-card master is the source of truth for name/type/brand/category/rarity/promo/image.
  const legacy=[];
  try{
    const d=await new Promise((resolve,reject)=>{
      const req=indexedDB.open(PREVIOUS_USER_DB);
      req.onsuccess=()=>resolve(req.result);
      req.onerror=()=>reject(req.error);
      req.onupgradeneeded=()=>{try{req.transaction.abort()}catch(_){} reject(new Error('no previous db'))};
    });
    if(d&&d.objectStoreNames.contains(USER_STORE)){
      const rows=await new Promise((resolve,reject)=>{
        const tx=d.transaction(USER_STORE,'readonly'); const q=tx.objectStore(USER_STORE).getAll();
        q.onsuccess=()=>resolve(q.result||[]); q.onerror=()=>reject(q.error||new Error('read failed'));
      });
      legacy.push(...rows);
      d.close();
    }
  }catch(_){ }
  try{
    const old=JSON.parse(localStorage.getItem('aikatsuEncoreCards')||'null');
    if(Array.isArray(old))legacy.push(...old.map(x=>({id:x?.id,owned:x?.owned})));
  }catch(_){ }
  const seen=new Set();
  for(const old of legacy){
    if(!old?.id||seen.has(old.id))continue;
    if(!masterFor(old.id))continue;
    const owned=Math.max(0,Number.parseInt(old.owned,10)||0);
    if(owned>0){ try{await putUserRow({id:old.id,owned,overrides:{}})}catch(_){ } }
    seen.add(old.id);
  }
  localStorage.setItem(MASTER_VERSION_KEY,MASTER_VERSION);
}
async function loadUserState(){
  cards=cloneMaster();
  try{
    await migrateToStableStoreOnce();
    const rows=await getUserRows();
    const byId=new Map(rows.map(r=>[r.id,r]));
    for(const card of cards){
      const row=byId.get(card.id);
      if(row) applyRow(card,row);
    }
  }catch(_){
    // Embedded master remains available even if browser storage is unavailable.
  }
  refreshBrands();
  render();
}
async function persistCard(card){
  const row=buildRowFromCard(card);
  try{
    await putUserRow(row);
    return true;
  }catch(_){
    // Fallback for owned + small metadata; large images remain in memory and the backup export can preserve them.
    try{
      const state={};
      const raw=localStorage.getItem('aikatsuEncoreUserState_v4');
      try{Object.assign(state,JSON.parse(raw||'{}'))}catch(_){}
      state[card.id]={...row,overrides:{...row.overrides}};
      localStorage.setItem('aikatsuEncoreUserState_v4',JSON.stringify(state));
      return true;
    }catch(_){
      alert('このブラウザでは保存領域を利用できません。バックアップを作成してください。');
      return false;
    }
  }
}
function render(){
  const q=$('q').value.trim().toLowerCase();
  const t=$('type').value,b=$('brand').value,c=$('cat').value,r=$('rarity').value;
  let a=cards.filter(x=>(!q||[x.id,x.name,x.brand].join(' ').toLowerCase().includes(q))&&(!t||x.type===t)&&(!b||x.brand===b)&&(!c||x.category===c)&&(!r||x.rarity===r));
  const s=$('sort').value;
  a.sort((x,y)=>s==='name'?x.name.localeCompare(y.name,'ja'):s==='rarity'?({'ER':0,'PR':1,'R':2,'N':3}[x.rarity]??9)-({'ER':0,'PR':1,'R':2,'N':3}[y.rarity]??9):s==='owned'?y.owned-x.owned:x.id.localeCompare(y.id));
  $('grid').innerHTML=a.map(x=>'<article class="card"><div class="pic">'+(x.image?'<img src="'+x.image+'" alt="'+esc(x.name)+'">':'<div class="placeholder">'+esc(x.id)+'<br>画像未登録</div>')+'</div><div class="body"><div class="row"><span class="id">'+esc(x.id)+(x.promo?' ・PROMO':'')+'</span><span class="rarity">'+esc(x.rarity)+'</span></div><div class="name">'+esc(x.name)+'</div><div class="meta">'+esc(x.type)+' / '+esc(x.brand)+'<br>'+esc(x.category)+'</div><div class="owned"><span>所持</span><div class="stepper"><button onclick="change(\''+x.id+'\',-1)">−</button><input class="ownedInput" type="number" min="0" step="1" value="'+x.owned+'" aria-label="'+esc(x.id)+'の所持枚数" onchange="setOwned(\''+x.id+'\',this.value)" onkeydown="if(event.key===\'Enter\'){this.blur()}" onclick="event.stopPropagation()"><button onclick="change(\''+x.id+'\',1)">＋</button></div></div><button class="editbtn" onclick="openEditor(\''+x.id+'\')">✏️ カード情報・画像を編集</button></div></article>').join('');
  $('empty').hidden=!!a.length;
  $('count').textContent=cards.length;
  $('ownedKinds').textContent=cards.filter(x=>x.owned>0).length;
  $('ownedTotal').textContent=cards.reduce((n,x)=>n+x.owned,0);
  $('rate').textContent=Math.round(cards.filter(x=>x.owned>0).length/cards.length*100)+'%';
  refreshBrands();
}
async function change(id,d){
  const x=cards.find(c=>c.id===id); if(!x)return;
  x.owned=Math.max(0,(Number.isFinite(Number(x.owned))?Number(x.owned):0)+d);
  if(await persistCard(x))render();
}
async function setOwned(id,value){
  const x=cards.find(c=>c.id===id); if(!x)return;
  const n=Math.max(0,Number.parseInt(String(value),10)||0);
  x.owned=n;
  if(await persistCard(x))render();
}
function openEditor(id){
  const x=cards.find(c=>c.id===id); if(!x)return;
  editingId=id; imageWasRemoved=false;
  $('eId').value=x.id; $('eName').value=x.name; $('eType').value=x.type; $('eBrand').value=x.brand; $('eCat').value=x.category; $('eRarity').value=x.rarity; $('ePromo').value=String(!!x.promo); $('eOwned').value=x.owned;
  $('ePreview').src=x.image||''; $('ePreview').style.visibility=x.image?'visible':'hidden'; $('eImage').value=''; $('editor').classList.add('open');
}
function closeEditor(){editingId=null;imageWasRemoved=false;$('editor').classList.remove('open');}
function removeImage(){if(!editingId)return;imageWasRemoved=true;$('ePreview').removeAttribute('src');$('ePreview').style.visibility='hidden';$('eImage').value='';}
$('eImage').addEventListener('change',e=>{const f=e.target.files[0];if(!f||!f.type.startsWith('image/'))return;imageWasRemoved=false;const r=new FileReader();r.onload=()=>{$('ePreview').src=r.result;$('ePreview').style.visibility='visible'};r.readAsDataURL(f)});
async function saveEditor(){
  const x=cards.find(c=>c.id===editingId); if(!x)return;
  x.name=$('eName').value.trim()||x.name; x.type=$('eType').value; x.brand=$('eBrand').value.trim()||'未確認'; x.category=$('eCat').value; x.rarity=$('eRarity').value; x.promo=$('ePromo').value==='true'; x.owned=Math.max(0,Number.parseInt($('eOwned').value||'0',10)||0);
  const src=$('ePreview').getAttribute('src')||''; if(imageWasRemoved)x.image=''; else if(src.startsWith('data:image/'))x.image=src;
  if(await persistCard(x)){render();closeEditor();}
}
function exportJSON(){const blob=new Blob([JSON.stringify(cards,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='aikatsu-encore-backup.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
function refreshBrands(){const sel=$('brand'),current=sel.value;sel.innerHTML='<option value="">ブランド：すべて</option>';[...new Set(cards.map(x=>x.brand).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'ja')).forEach(v=>sel.insertAdjacentHTML('beforeend','<option value="'+esc(v)+'">'+esc(v)+'</option>'));sel.value=current&&[...sel.options].some(o=>o.value===current)?current:'';}
['q','type','brand','cat','rarity','sort'].forEach(id=>$(id).addEventListener('input',render));
refreshBrands();
loadUserState();
